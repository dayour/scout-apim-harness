# Scout APIM Harness Configuration
# Copy this file to .env and configure every required value.
# .env is loaded for local development; packaged deployments can set
# SCOUT_ENV_FILE to an external file or provide environment variables directly.

# === Tenant Configuration ===
SCOUT_TENANT_ID=

# === Azure Bot Configuration ===
SCOUT_BOT_APP_ID=
SCOUT_BOT_APP_PASSWORD=

# === Relay Server Configuration ===
# Hostname where the relay server runs.
SCOUT_RELAY_HOST=localhost

# Bot Framework HTTP port (Teams messages endpoint)
SCOUT_HTTP_PORT=3978

# WebSocket relay port (Scout desktop connections)
SCOUT_WS_PORT=8765

# Full public WebSocket URL advertised to Scout clients.
# Example: wss://relay.example.com/ws
SCOUT_RELAY_WS_URL=

# Loki URL advertised for Prepare/Horizon GraphQL.
# Example: https://loki.example.com
SCOUT_LOKI_URL=
