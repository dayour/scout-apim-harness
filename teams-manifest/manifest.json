{
  "$schema": "https://developer.microsoft.com/json-schemas/teams/v1.17/MicrosoftTeams.schema.json",
  "manifestVersion": "1.17",
  "version": "1.0.0",
  "id": "00000000-0000-0000-0000-000000000000",
  "name": {
    "short": "ClippyClaw",
    "full": "ClippyClaw AI Assistant"
  },
  "description": {
    "short": "Your AI desktop assistant, on the go",
    "full": "Chat with your ClippyClaw AI assistant from anywhere — phone, tablet, or desktop Teams. ClippyClaw connects to your running desktop instance to give you full access to your files, browser, calendar, and more. Requires ClippyClaw desktop app running on your computer."
  },
  "icons": {
    "color": "color.png",
    "outline": "outline.png"
  },
  "accentColor": "#6366F1",
  "developer": {
    "name": "Microsoft",
    "websiteUrl": "https://github.com/microsoft/clawpilot",
    "privacyUrl": "https://go.microsoft.com/fwlink/?LinkId=521839",
    "termsOfUseUrl": "https://go.microsoft.com/fwlink/?LinkID=206977"
  },
  "bots": [
    {
      "botId": "00000000-0000-0000-0000-000000000000",
      "scopes": ["personal"],
      "supportsFiles": false,
      "isNotificationOnly": false,
      "commandLists": [
        {
          "scopes": ["personal"],
          "commands": [
            {
              "title": "New session",
              "description": "Start a fresh chat session"
            },
            {
              "title": "help",
              "description": "Show what ClippyClaw can do"
            },
            {
              "title": "status",
              "description": "Check if ClippyClaw desktop is connected"
            },
            {
              "title": "cancel",
              "description": "Stop the in-flight turn"
            }
          ]
        }
      ]
    }
  ],
  "permissions": ["identity", "messageTeamMembers"],
  "validDomains": ["relay.example.com"]
}
