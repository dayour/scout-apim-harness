{
  "$schema": "https://developer.microsoft.com/json-schemas/teams/v1.17/MicrosoftTeams.schema.json",
  "manifestVersion": "1.17",
  "version": "1.0.0",
  "id": "${SCOUT_BOT_APP_ID}",
  "name": {
    "short": "Scout",
    "full": "Scout AI Assistant"
  },
  "description": {
    "short": "Access your Scout assistant from Microsoft Teams",
    "full": "Chat with your Scout assistant from Teams on desktop, web, phone, or tablet. The configured Scout desktop instance and relay must be running and connected."
  },
  "icons": {
    "color": "color.png",
    "outline": "outline.png"
  },
  "accentColor": "#00B4D8",
  "developer": {
    "name": "Scout contributors",
    "websiteUrl": "https://github.com/dayour/scout-apim-harness",
    "privacyUrl": "https://github.com/dayour/scout-apim-harness",
    "termsOfUseUrl": "https://github.com/dayour/scout-apim-harness"
  },
  "bots": [
    {
      "botId": "${SCOUT_BOT_APP_ID}",
      "scopes": ["personal"],
      "supportsFiles": false,
      "isNotificationOnly": false,
      "commandLists": [
        {
          "scopes": ["personal"],
          "commands": [
            {
              "title": "New session",
              "description": "Start a fresh chat session"
            },
            {
              "title": "help",
              "description": "Show what Scout can do"
            },
            {
              "title": "status",
              "description": "Check whether Scout desktop is connected"
            },
            {
              "title": "cancel",
              "description": "Stop the in-flight turn"
            }
          ]
        }
      ]
    }
  ],
  "permissions": ["identity", "messageTeamMembers"],
  "validDomains": ["${SCOUT_RELAY_DOMAIN}"]
}
